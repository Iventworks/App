{
	"name": "iventworks",
	"version": "1.0.2",
	"private": true,
	"type": "module",
	"description": "Iventworks — planning camps and events for organisations (full-stack Nuxt app)",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun nuxt typecheck && bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test --timeout 30000",
		"test:ci": "bun test --timeout 30000 --coverage --reporter=junit --reporter-outfile=./junit.xml",
		"db:generate": "bun scripts/db-utils && bunx --bun drizzle-kit generate --config=drizzle/configs/drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils && bunx --bun drizzle-kit migrate --config=drizzle/configs/drizzle.config.ts",
		"db:import-legacy": "bun scripts/import-legacy-db.ts",
		"backup": "bun scripts/backup.ts",
		"api-client:generate": "bun scripts/api-client-generate.ts",
		"dev": "bunx --bun nuxt dev --port 31316",
		"generate": "bunx --bun nuxt generate",
		"preview": "bunx --bun nuxt preview",
		"postinstall": "bunx --bun nuxt prepare",
		"build": "nuxt build --preset bun && bun run build:backup-cli",
		"build:backup-cli": "bun build scripts/backup.ts --target=bun --outfile=.output/backup.mjs",
		"start": "PORT=31316 bun run .output/server/index.mjs"
	},
	"dependencies": {
		"@cleverjs/utils": "^1.2.5",
		"@hono/standard-validator": "^0.3.0",
		"@iconify/vue": "5.0.5",
		"@internationalized/date": "^3.12.4",
		"@nuxt/ui": "^4.9.0",
		"@scalar/hono-api-reference": "^0.11.9",
		"@vite-pwa/nuxt": "^1.1.0",
		"@vueuse/core": "^14.4.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"elliptic": "^6.6.1",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"nodemailer": "^10.4.0",
		"nuxt": "^4.6.2",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0",
		"web-push": "3.6.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@hey-api/nuxt": "^0.2.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@iconify-json/lucide": "^1.2.117",
		"@libsql/client": "^0.17.4",
		"@types/bun": "^1.4.3",
		"@types/elliptic": "^6.4.18",
		"@types/nodemailer": "^8.0.2",
		"@types/web-push": "^3.6.4",
		"bun-types": "^1.4.2",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.6"
	},
	"overrides": {
		"defu": "^6.1.7",
		"js-yaml": "^4.3.2"
	}
}
