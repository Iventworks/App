# Before the rename to Iventworks these variables were called CMP_*; those names still work as a
# fallback (with a warning at startup).

IVENTWORKS_LOG_LEVEL=info

# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
IVENTWORKS_API_DISABLE_DOCS=false

IVENTWORKS_DB_PATH=./data/db.sqlite
IVENTWORKS_DB_AUTO_MIGRATE=true
IVENTWORKS_DB_MIGRATION_DIR=./drizzle/migrations

IVENTWORKS_LOG_DIR=./data/logs
IVENTWORKS_CONFIG_BASE_DIR=./config

# Uploaded documents and receipts (files on disk, metadata in the DB)
IVENTWORKS_UPLOAD_DIR=./data/uploads
IVENTWORKS_MAX_UPLOAD_SIZE_MB=25

# Behind exactly one reverse proxy (Traefik, nginx, …) that appends the client address to
# X-Forwarded-For: use the last entry as the client IP for login rate limiting. Leave false when
# the app port is reachable directly (the header would be spoofable).
IVENTWORKS_TRUST_PROXY=false

# IANA time zone that decides what "today" means for dashboards and schedules
IVENTWORKS_TIMEZONE=Europe/Berlin

# Single-org mode: the app's URL. Multi-org mode: the base URL — every org lives at
# <slug>.<host of this URL> (e.g. crossover.app.iventworks.de), the system admin dashboard at
# <this URL>/admin. Point a wildcard DNS record (*.app.iventworks.de) at the server; custom domains
# of orgs point at their org's default domain via CNAME.
IVENTWORKS_APP_URL=http://localhost:31316

# Host many orgs on one installation (own users, data, branding and custom domains each).
# false: one org answers on every host name. Locally, orgs are reachable at <slug>.localhost.
IVENTWORKS_MULTI_ORG=false

# Multi-org mode: org admins' custom domains go live by themselves once their DNS records check out.
# Only for reverse proxies that serve new domains on their own (e.g. Caddy on-demand TLS with
# `ask` -> /api/v1/instance/tls-check). false: a system admin adds the domain to the reverse proxy
# and then approves it under <APP_URL>/admin/domains.
IVENTWORKS_CUSTOM_DOMAINS_SELF_SERVICE=false

IVENTWORKS_SMTP_HOST=mail.example.com
IVENTWORKS_SMTP_PORT=465
IVENTWORKS_SMTP_USERNAME=user
IVENTWORKS_SMTP_PASSWORD=
IVENTWORKS_SMTP_FROM='"Iventworks" <noreply@iventworks.de>'
IVENTWORKS_SMTP_SECURE=true
