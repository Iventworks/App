
CMP_LOG_LEVEL=info

# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
CMP_API_DISABLE_DOCS=false

CMP_DB_PATH=./data/db.sqlite
CMP_DB_AUTO_MIGRATE=true
CMP_DB_MIGRATION_DIR=./drizzle/migrations

CMP_LOG_DIR=./data/logs
CMP_CONFIG_BASE_DIR=./config

CMP_APP_URL=http://localhost:31316

CMP_SMTP_HOST=mail.example.com
CMP_SMTP_PORT=465
CMP_SMTP_USERNAME=user
CMP_SMTP_PASSWORD=
CMP_SMTP_FROM='"CMP" <noreply@crossover.info>'
CMP_SMTP_SECURE=true
# Shows the signup link and page (frontend only; read at build time and mapped at server start)
CMP_ENABLE_SIGNUP=false
